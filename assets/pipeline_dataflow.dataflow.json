  "cards": [
    {
      "dot": "emerald",
      "title": "Order and inputs",
      "items": [
        "The runner executes dem, gfm, osm, flexth, population and ghsl in that fixed order",
        "Every step reads the same AOI vector and config.yaml, so no step draws its own extent",
        "GFM flood extent plus the FABDEM-derived DTM are the two inputs FLEXTH needs"
      ]
    },
    {
      "dot": "cyan",
      "title": "Shared versus per-scene data",
      "items": [
        "DEM, WorldPop, GHSL and the OSM road/rail layers are each fetched once per AOI and cached on disk",
        "Flood masks, depth rasters and damage rasters are written per band and scene timestamp",
        "A whole-time maximum flood extent is written alongside the per-scene masks"
      ]
    },
    {
      "dot": "orange",
      "title": "Where exposure is computed",
      "items": [
        "The ghsl step combines depth with built-up classes into damage and EUR bands",
        "The population step only downloads WorldPop; the Results page derives exposed population from depth",
        "The dashboard reads what the steps already wrote and never fetches source data itself"
      ]
    }
  ]
